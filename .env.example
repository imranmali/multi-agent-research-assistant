# Copy to .env and adjust. Every setting maps to an upper-case environment variable
# (see src/research_assistant/config.py). Values shown are the defaults.
# Never commit a real .env; it is git- and docker-ignored.

# --- service --------------------------------------------------------------------------
APP_NAME=multi-agent-research-assistant
# development | staging | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO
# true = JSON log lines (production); false = human-readable console logs
LOG_JSON=true

# --- LLM ------------------------------------------------------------------------------
# mock = deterministic offline provider (no key, no network); anthropic = Claude
LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = deeper reasoning, more tokens, more cost)
ANTHROPIC_EFFORT=medium
# Max output tokens per call (1024-128000)
ANTHROPIC_MAX_TOKENS=16000
# Per-request timeout for Claude calls, seconds
ANTHROPIC_TIMEOUT_SECONDS=600
# SDK retries on 429/5xx (0-10)
ANTHROPIC_MAX_RETRIES=3
# Server-side refusal fallbacks
ANTHROPIC_ENABLE_FALLBACKS=true
# Max web searches per research sub-question (1-20)
MAX_SEARCH_USES=5

# --- research pipeline defaults (overridable per request) -----------------------------
# Sub-questions the Planner may produce (1-10)
MAX_SUBQUESTIONS=4
# Sub-questions researched concurrently (1-16)
MAX_PARALLEL_RESEARCH=4
# Critic-driven revision rounds (0-5)
MAX_REVISIONS=1

# --- jobs -----------------------------------------------------------------------------
# memory = run jobs inside the API process (single replica, dev only)
# redis  = shared store + queue, jobs executed by `research-worker` processes
JOB_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Retention of jobs and their events in seconds (default 7 days)
JOB_TTL_SECONDS=604800
# Jobs one worker process runs concurrently (1-64)
WORKER_CONCURRENCY=2
# Seconds a worker waits for running jobs on SIGTERM
WORKER_SHUTDOWN_GRACE_SECONDS=30
QUEUE_NAME=research:queue
# Port of the worker's Prometheus metrics endpoint
WORKER_METRICS_PORT=9100

# --- API ------------------------------------------------------------------------------
# Comma-separated API keys required in the X-API-Key header on /v1 routes.
# Leave commented out to disable authentication (local development only).
# API_KEYS=change-me-1,change-me-2
# Comma-separated allowed CORS origins; commented out = CORS disabled.
# CORS_ORIGINS=https://app.example.com
# Maximum page size of GET /v1/research
MAX_LIST_LIMIT=100
# How often the SSE endpoint polls for new events, seconds
SSE_POLL_INTERVAL_SECONDS=0.5
